# Скопіюйте цей файл у .env і заповніть значення

BOT_TOKEN=1234567890:AAAA-your-token-here
# Telegram ID адміністраторів через кому — сюди приходять заявки
ADMIN_IDS=123456789

# Ключ Claude API: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5
# low | medium | high — глибина міркувань моделі (вище = якісніше, але довше й дорожче)
CLAUDE_EFFORT=low
MAX_TOKENS=1024
# Якщо основна модель відхилить запит — автоматично повторити на резервній
CLAUDE_FALLBACKS=true

BUSINESS_NAME=БудКомфорт
KNOWLEDGE_FILE=knowledge/faq.md
# Скільки останніх повідомлень діалогу пам'ятає бот
HISTORY_LIMIT=12
# Ліміт запитань до AI на одного користувача за годину (захист бюджету)
RATE_LIMIT_PER_HOUR=30

DATABASE_URL=sqlite+aiosqlite:///data/ai.db
LOG_LEVEL=INFO
