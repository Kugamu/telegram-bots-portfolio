# Скопіюйте цей файл у .env і заповніть значення

BOT_TOKEN=1234567890:AAAA-your-token-here
# Telegram ID адміністраторів через кому (дізнатися: @userinfobot)
ADMIN_IDS=123456789

DATABASE_URL=sqlite+aiosqlite:///data/booking.db

BUSINESS_NAME=Barber Club
BUSINESS_ADDRESS=м. Київ, вул. Хрещатик, 1
BUSINESS_PHONE=+380 67 000 00 00
TIMEZONE=Europe/Kyiv

# Крок сітки слотів, хв
SLOT_STEP_MIN=30
# На скільки днів уперед відкрито запис
BOOKING_DAYS_AHEAD=30
# Мінімум хвилин від поточного моменту до запису
MIN_LEAD_MIN=30
# За скільки годин надсилати нагадування
REMIND_HOURS=2
# Пізніше ніж за N годин скасувати можна лише телефоном
CANCEL_MIN_HOURS=2

SEED_DEMO_DATA=true
LOG_LEVEL=INFO
