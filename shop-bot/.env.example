# Скопіюйте цей файл у .env і заповніть значення

# Токен від @BotFather
BOT_TOKEN=1234567890:AAAA-your-token-here

# Telegram ID адміністраторів через кому (дізнатися свій ID: @userinfobot)
ADMIN_IDS=123456789

# SQLite за замовчуванням; для PostgreSQL: postgresql+asyncpg://user:pass@host:5432/shop
DATABASE_URL=sqlite+aiosqlite:///data/shop.db

SHOP_NAME=Brew & Bean
PAYMENT_DETAILS=Монобанк 5375 0000 0000 0000, ФОП Іваненко І.І.

# Заповнити БД демо-товарами при першому запуску (true/false)
SEED_DEMO_DATA=true
LOG_LEVEL=INFO
